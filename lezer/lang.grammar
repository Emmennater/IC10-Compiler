@precedence {
  call, neg, list, times @left, plus @left, shift @left, comp @left,
  bitand @left, bitxor @left, bitor @left, and @left, or @left
}

kw<term> { @specialize[@name={term}]<identifier, term> }
kw_<term> { @specialize<identifier, term> }

@top program { block }

block { statement* }

statement {
  Declaration | ArrayDeclaration | Assignment | IfExpr | LoopExpr | WhileExpr | RepeatUntilExpr |
  kw<"break"> | kw<"continue"> | Instruction | FunctionCall | DeviceDeclaration | Definition |
  FunctionDef | Return | PreprocessorDirective | ForExpr | ForInExpr | ForOfExpr | Import |
  StackDeclaration
}

Declaration {
  (kw<"let"> | kw<"const">) VariableName
  (Assign expression)?
}

ArrayDeclaration {
  kw<"let"> VariableName !list BracketLeft expression BracketRight
  (Assign List)?
}

StackDeclaration {
  kw<"stack"> VariableName
  (Assign expression)?
}

DeviceDeclaration { kw<"device"> VariableName Assign Device }

Definition { kw<"define"> VariableName Assign expression }

Assignment { Value (Assign | CompoundAssignOp) expression }

If { kw<"if"> expression kw<"then"> block }

ElseIf { kw<"elif"> expression kw<"then"> block }

Else { kw<"else"> block }

IfExpr { If ElseIf* Else? kw<"end"> }

LoopExpr { kw<"loop"> block kw<"end"> }

WhileExpr { kw<"while"> expression kw<"do"> block kw<"end"> }

RepeatUntilExpr { kw<"repeat"> block kw<"until"> expression }

ForExpr { kw<"for"> statement? Comma expression? Comma statement? kw<"do"> block kw<"end"> }

ForInExpr { kw<"for"> Declaration kw<"in"> VariableName kw<"do"> block kw<"end"> }

ForOfExpr { kw<"for"> Declaration kw<"of"> VariableName kw<"do"> block kw<"end"> }

Instruction { kw_<"yield"> | kw_<"sleep"> expression }

FunctionCall { FunctionName !call ParenLeft (expression (Comma expression)*)? ParenRight }

FunctionDef {
  kw<"fn"> FunctionName !call ParenLeft (VariableName (Comma VariableName)*)? ParenRight FunctionBlock
  kw<"end">
}

FunctionBlock { block }

Return { kw<"return"> expression }

PreprocessorDirective { At DirectiveName }

DirectiveName { kw_<"constexpr"> }

Import { kw<"import"> VariableName kw<"from"> String (kw<"using"> Device)? }

expression { Number | Bool | Value | Parens | UnaryOp | BinaryOp | FunctionCall | String }

VariableName { identifier }

FunctionName { identifier }

Indexing { BracketLeft (expression) BracketRight }

PropertyAccessor { Dot VariableName }

Value {
  (VariableName | Device)
  Indexing?
  PropertyAccessor?
}

Parens { ParenLeft expression ParenRight }

UnaryOp { !neg (AddOp | Not | BitNot) expression }

BinaryOp {
  expression !times MulOp expression |
  expression !plus AddOp expression |
  expression !shift ShiftOp expression |
  expression !comp CompareOp expression |
  expression !bitand BitAnd expression |
  expression !bitxor BitXor expression |
  expression !bitor BitOr expression |
  expression !and LogicAnd expression |
  expression !or LogicOr expression
}

Device { kw_<"d0"> | kw_<"d1"> | kw_<"d2"> | kw_<"d3"> | kw_<"d4"> | kw_<"d5"> | kw_<"db"> }

Bool { kw_<"true"> | kw_<"false"> }

List { BracketLeft (expression (Comma expression)*)? BracketRight }

@tokens {
  identifier { $[a-zA-Z_] $[a-zA-Z0-9_]* }
  spaces { @whitespace }
  // A base prefix (0x/0b, as in JavaScript) or a "c" suffix marking the
  // number as a Celsius reading. `_` may separate digits of a based literal,
  // the way the game's own binary notation writes %0110_1000. Longest match
  // picks the based forms over the plain "0" that also starts them.
  based {
    ("0" $[xX] $[0-9a-fA-F] $[0-9a-fA-F_]*) |
    ("0" $[bB] $[01] $[01_]*)
  }
  Number { based | (@digit+ ("." | "." @digit+)? $[cC]?) }
  // Integer { based | @digit+ }
  MulOp { "*" | "/" | "%" }
  AddOp { "+" | "-" }
  Not { "!" }
  BitNot { "~" }
  // ">>" is the arithmetic (sign-preserving) shift and ">>>" the logical
  // one, as in JavaScript; they resolve to IC10's `sra` and `srl`.
  ShiftOp { "<<" | ">>" | ">>>" }
  CompareOp { "==" | "!=" | "<=" | ">=" | "<" | ">" }
  BitAnd { "&" }
  BitXor { "^" }
  BitOr { "|" }
  LogicAnd { "&&" }
  LogicOr { "||" }
  Assign { "=" }
  CompoundAssignOp {
    "+=" | "-=" | "*=" | "/=" | "%=" |
    "&=" | "|=" | "^=" | "<<=" | ">>=" | ">>>="
  }
  ParenLeft { "(" }
  ParenRight { ")" }
  BracketLeft { "[" }
  BracketRight { "]" }
  Dot { "." }
  Comma { "," }
  At { "@" }
  String { '"' (!["\\] | "\\" _)* '"' }
  Comment { "#" ![\n]* }
}

@skip { spaces | Comment }