{
  "name": "ic10-compiler",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cases": "node tests/test.mjs",
    "lezer": "lezer-generator lezer/lang.grammar -o lezer/parser.js",
