# Both halves are bundled by esbuild into their out/*.js, so neither's
# node_modules nor source is needed at runtime.
server/node_modules/**
server/src/**
server/esbuild.mjs
client/node_modules/**
client/src/**
client/esbuild.mjs

# Build/dev metadata, not needed at runtime
**/tsconfig.json
**/tsconfig.tsbuildinfo
**/package-lock.json
.vscode/**
.gitignore
.vscodeignore
